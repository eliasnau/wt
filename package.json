{
  "name": "matdesk",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @matdesk/db db:push",
    "db:studio": "turbo -F @matdesk/db db:studio",
    "db:generate": "turbo -F @matdesk/db db:generate",
    "db:migrate": "turbo -F @matdesk/db db:migrate",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@matdesk/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@matdesk/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.1.2"
}
