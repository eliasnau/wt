# Copy to `.env` and fill in. Validated by `packages/env/src/server.ts`.

# --- Required ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=

# --- Optional: rate limiting (Upstash Redis). Unset → fails open. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: evlog wide events → Axiom. Unset → local FS / console drain. ---
AXIOM_API_KEY=
AXIOM_DATASET=
AXIOM_EDGE_URL=

# --- Optional: geocoding (member address → lat/lng, inline on create/update).
# Unset BASE_URL falls back to public OpenStreetMap Nominatim (~1 req/s, no SLA).
GEOCODING_BASE_URL=https://eu1.locationiq.com/v1/search
GEOCODING_API_KEY=
GEOCODING_USER_AGENT=matdesk
